# --- Режим 1: OAuth (редагування ваших власних файлів) ---
# Шлях до OAuth client secrets (тип "Desktop app") з Google Cloud Console.
GOOGLE_OAUTH_CLIENT_SECRETS=./credentials.json
# Куди зберігати виданий токен після першої авторизації.
GOOGLE_OAUTH_TOKEN_PATH=./token.json

# --- Режим 2: Service account (сервер/автоматизація) ---
# Якщо задано — використовується замість OAuth.
# GOOGLE_SERVICE_ACCOUNT_FILE=./service-account.json
# Email користувача для делегування (domain-wide delegation), за потреби.
# GOOGLE_IMPERSONATE_SUBJECT=user@your-domain.com
